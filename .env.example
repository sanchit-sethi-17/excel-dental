# Excel Dental — environment variables
# Copy to .env.local for local overrides. Set the real values on Vercel.
#
# LOCAL DEV needs nothing here — the patient portal uses Node's built-in SQLite
# (a file at .data/app.db). These variables are only needed in PRODUCTION.

# Postgres connection string (Neon or Vercel Postgres). Required in production.
DATABASE_URL=

# Long random string used to secure sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional — connect real email so OTP codes & password-reset links get sent.
# Without this, codes/links are shown on screen (dev mode) instead.
RESEND_API_KEY=
