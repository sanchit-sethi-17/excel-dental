# Excel Dental — environment variables
# Copy to .env.local for local development. Set the real values on Vercel.

# ---------------------------------------------------------------------------
# BOOKING NOTIFICATIONS  (set these and booking requests get emailed)
# ---------------------------------------------------------------------------
# Without these the site still works: requests are validated, given a
# reference, written to the server log, and handed off to WhatsApp. But the
# clinic won't get an email, so set them before launch.

# Where booking requests are sent. Falls back to `email` in src/lib/site.ts.
CLINIC_EMAIL=

# API key from https://resend.com (free tier is plenty).
RESEND_API_KEY=

# The "from" address. Resend only sends from a domain you've verified — until
# the clinic has one, leave this blank and their test sender is used.
BOOKING_FROM_EMAIL=

# ---------------------------------------------------------------------------
# PATIENT PORTAL  (only needed if _parked/patient-portal/ is restored)
# ---------------------------------------------------------------------------

# Postgres connection string (Neon or Vercel Postgres).
DATABASE_URL=

# Long random string for sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=
